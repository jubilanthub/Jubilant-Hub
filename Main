<script>
// Hide loader after 2.5s no matter what
setTimeout(() => {
document.getElementById("loader").style.display="none";
document.getElementById("main").style.display="block";
}, 2500);

let cartItems=[];
const gallery=document.getElementById("gallery");

const categories={
dresses:[],shoes:[],men:[],sneakers:[],slippers:[],other:[]
};

// Use placeholder images if yours don't exist yet
const placeholder = 'https://via.placeholder.com/300x300/222/D4AF37?text=Product';

for(let i=1;i<=80;i++){
categories.dresses.push({n:'Dress '+i,p:'R150',img:placeholder});
}
for(let i=1;i<=6;i++){
categories.shoes.push({n:'Shoe '+i,p:'R250',img:placeholder});
}
for(let i=1;i<=30;i++){
categories.men.push({n:'Men Outfit '+i,p:'R350',img:placeholder});
}
for(let i=1;i<=30;i++){
categories.sneakers.push({n:'Sneaker '+i,p:'R300',img:placeholder});
}
for(let i=1;i<=6;i++){
categories.slippers.push({n:'Slipper '+i,p:'R160',img:placeholder});
}
for(let i=1;i<=30;i++){
categories.other.push({n:'Other '+i,p:'R200',img:placeholder});
}

function showCategory(cat){
gallery.innerHTML='';
categories[cat].forEach(item=>{
gallery.innerHTML += `
<div class="product">
<img src="${item.img}" alt="${item.n}" onerror="this.src='${placeholder}'">
<div class="info">
<h3>${item.n}</h3>
<p class="price">${item.p}</p>
<button onclick="buy('${item.n}')">Add To Cart</button>
</div>
</div>
`;
});
}

function buy(item){
cartItems.push(item);
document.getElementById("cartCount").innerText = cartItems.length;
}

function placeOrder(){
if(cartItems.length===0){alert("Cart is empty");return;}
let msg = "Hello Michael Maluleka Vision Hub,%0A%0A";
msg += "I want to order:%0A";
cartItems.forEach((item,index)=>{
msg += (index+1)+". "+item+"%0A";
});
window.open("https://wa.me/27732176610?text="+msg, "_blank");
}

function searchProducts(){
let value = document.getElementById("searchInput").value.toUpperCase();
document.querySelectorAll(".product").forEach(product=>{
product.style.display = product.innerText.toUpperCase().includes(value)? "" : "none";
});
}

showCategory("dresses");
</script>
